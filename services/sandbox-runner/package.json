{
  "name": "@snapjaw/sandbox-runner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Snapjaw sandbox runner — owns the warm container pool that executes untrusted Python.",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "image:build": "docker build -t snapjaw-runner:latest runner-image"
  },
  "dependencies": {
    "express": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
